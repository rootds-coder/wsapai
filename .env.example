# Copy to .env and fill in real values. NEVER commit .env.
# Generate secrets with: openssl rand -hex 32

NODE_ENV=development
PORT=3000
OPEN_BROWSER=false

# REQUIRED in production (server refuses to start in production without them)
# ADMIN_PASSWORD: at least 12 characters. This is the ONLY master-admin
# credential — there are no fallback / default passwords.
ADMIN_PASSWORD=
# SESSION_SECRET: at least 32 random characters.
SESSION_SECRET=

# Allowed origin for Socket.io CORS (your public app URL, e.g. https://app.example.com)
# Leave empty to disable cross-origin socket connections.
ALLOWED_ORIGIN=
APP_URL=

# Database
MONGODB_URI=

# AI providers (at least one)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# WhatsApp
ENABLE_WHATSAPP=true
WA_AUTH_FOLDER=./auth_info_baileys

# Keep-alive ping (prevents some hosts from sleeping)
KEEP_ALIVE_ENABLED=true
KEEP_ALIVE_INTERVAL=600000

# Opt-in group AI. Comma-separated exact WhatsApp group JIDs.
GROUP_AI_ENABLED=false
GROUP_AI_IDS=
GROUP_AI_COOLDOWN_SECONDS=20
GROUP_AI_SPONTANEOUS_CHANCE=0
GROUP_AI_PROFANITY=true
GROUP_AI_MODEL=
GROUP_AI_STATE_FILE=./data/group-state.json
